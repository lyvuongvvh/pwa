rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Security Helpers
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'lyvuong@viethoc.com';
    }

    function isAdmin() {
      return isSignedIn() && (isBootstrapAdmin() || exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isEditor() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['editor', 'admin']
      );
    }

    function isValidUserProfile(data) {
      return data.email is string && data.email.size() <= 128 &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.role in ['admin', 'editor', 'viewer'];
    }

    function isValidDocument(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 255 &&
             data.fileName is string && data.fileName.size() > 0 && data.fileName.size() <= 255 &&
             data.fileType in ['pdf', 'html', 'text'] &&
             data.authorId is string && data.authorId == request.auth.uid &&
             (!('summary' in data) || (data.summary is string && data.summary.size() <= 2000)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    function isValidArticle(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 255 &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 300000 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             (!('excerpt' in data) || (data.excerpt is string && data.excerpt.size() <= 600)) &&
             (!('category' in data) || (data.category is string && data.category.size() <= 100));
    }

    // Admins Collection
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Users Collection
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      
      // Allow user creation on initial sign in; self-assigned role can only be viewer unless bootstrap admin
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUserProfile(incoming()) && (
        (isBootstrapAdmin() && incoming().role == 'admin') ||
        incoming().role == 'viewer'
      );

      // Updates: standard users cannot change their own role, admins can update any profile
      allow update: if isSignedIn() && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          request.auth.uid == userId &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // Documents Collection (HTML & PDF archives with full-text search capability)
    match /documents/{documentId} {
      // All visitors (authenticated or unauthenticated) can read and search the document archive
      allow get, list: if true;

      // Only authenticated users with editor or admin role can upload
      allow create: if isEditor() && isValidId(documentId) && isValidDocument(incoming());

      // Editors can update their own documents, Admins can update any document
      allow update: if isValidId(documentId) && (
        isAdmin() ||
        (
          isEditor() &&
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          isValidDocument(incoming())
        )
      );

      // Editors can delete their own documents, Admins can delete any document
      allow delete: if isValidId(documentId) && (
        isAdmin() ||
        (
          isEditor() &&
          existing().authorId == request.auth.uid
        )
      );
    }

    // Articles / News Collection
    match /articles/{articleId} {
      // Publicly viewable news and articles
      allow get, list: if true;

      // Only editors and admins can post articles
      allow create: if isEditor() && isValidId(articleId) && isValidArticle(incoming());

      // Editors can update their own articles, Admins can update any
      allow update: if isValidId(articleId) && (
        isAdmin() ||
        (
          isEditor() &&
          existing().authorId == request.auth.uid &&
          incoming().authorId == existing().authorId &&
          incoming().createdAt == existing().createdAt &&
          isValidArticle(incoming())
        )
      );

      // Editors can delete their own articles, Admins can delete any
      allow delete: if isValidId(articleId) && (
        isAdmin() ||
        (
          isEditor() &&
          existing().authorId == request.auth.uid
        )
      );
    }

    // Test connection doc (for connectivity validation as mandated by skill)
    match /test/connection {
      allow read: if true;
    }
  }
}
